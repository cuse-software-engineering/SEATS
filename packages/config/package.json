{
  "name": "@seats/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/index.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "description": "The one place that knows where the parts of SEATS run...",
  "scripts": {
    "test": "node --import tsx --test 'test/*.test.ts'",
    "typecheck": "tsc -p . --noEmit",
    "build": "tsc -p tsconfig.json"
  }
}