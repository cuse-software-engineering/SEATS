{
  "name": "@seats/monolith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monolith mode (ADR-14): the six services and the API Gateway in one process, calls in memory through the Protocol Buffers serializers; for development and the in-process end-to-end tests, never a deployment target.",
  "scripts": {
    "dev": "tsx src/server.ts",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p . --noEmit",
    "build": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "@seats/booking": "*",
    "@seats/concert-round": "*",
    "@seats/config": "*",
    "@seats/gateway": "*",
    "@seats/notification": "*",
    "@seats/payment": "*",
    "@seats/staff-account": "*",
    "@seats/table-availability": "*"
  },
  "devDependencies": {
    "@seats/proto": "*",
    "@types/express": "^5.0.0"
  }
}
