{
  "name": "@seats/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API Gateway: the only REST API; fake auth by headers in progress 1; each route is one gRPC call to the owning service.",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "@seats/config": "*",
    "@seats/errors": "*",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@seats/proto": "*",
    "@types/express": "^5.0.0"
  }
}
